[
	// custom variants sort after every builtin, in registration order
	"hocus:p-2 hover:p-3 p-1 any-hover:p-4 theme-midnight:p-5 focus:p-6",
	"theme-midnight:p-5 any-hover:p-4 hocus:p-2 p-1",
	// stacked with builtins
	"hocus:sm:p-2 sm:hocus:p-3 sm:p-4 hocus:p-1 p-0",
	"group-hocus:p-2 group-hover:p-3 p-1",
	// overridden builtins keep their place
	"dark:p-2 hover:p-3 sm:p-4 p-1 dark:hover:p-5 hover:dark:p-6"
]
